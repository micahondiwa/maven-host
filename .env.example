# Local-only example. Never paste production credentials into development.
DATABASE_URL=postgresql://mavenhost_local@127.0.0.1:55438/mavenhost_local
APP_ORIGIN=http://localhost:3000
# Explicitly opt in to development seeding/testing on an isolated local database.
LOCAL_DATABASE_ONLY=true
INTEGRATIONS_MODE=test
# Must equal the v1 Django SECRET_KEY in production so existing JWT sessions and reset links stay valid.
SECRET_KEY=change-me-local-only
FRONTEND_URL=http://localhost:3000
