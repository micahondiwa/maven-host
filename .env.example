# Local-only example. Never paste production credentials into development.
DATABASE_URL=postgresql://mavenhost_local@127.0.0.1:55438/mavenhost_local
APP_ORIGIN=http://localhost:3000
# Explicitly opt in to development seeding/testing on an isolated local database.
LOCAL_DATABASE_ONLY=true
INTEGRATIONS_MODE=test
# Must equal the v1 Django SECRET_KEY in production so existing JWT sessions and reset links stay valid.
SECRET_KEY=change-me-local-only
FRONTEND_URL=http://localhost:3000

# Email: without EMAIL_HOST, messages are printed to the console (development only; production refuses to start sending).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# OAuth sign-in (each provider needs all three values).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# Maven Assistant and AI website builder. Providers are tried in AI_PROVIDER_ORDER; if one cannot serve a request
# (missing/expired key, exhausted credit or quota, rate limit, outage, timeout) the next one is used automatically.
AI_PROVIDER_ORDER=openai,anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_TIMEOUT_SECONDS=45
OPENAI_INPUT_COST_PER_MILLION=0
OPENAI_OUTPUT_COST_PER_MILLION=0
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_TIMEOUT_SECONDS=120
ANTHROPIC_INPUT_COST_PER_MILLION=4
ANTHROPIC_OUTPUT_COST_PER_MILLION=20

# Seven-day website trials (fake keeps deployments in memory; cloudflare_r2 uploads for infra/trial-worker).
TRIAL_DEPLOYMENT_PROVIDER=fake
TRIAL_BASE_DOMAIN=maven-trial.localhost
TRIAL_PUBLIC_SCHEME=https
TRIAL_R2_ENDPOINT=
TRIAL_R2_ACCESS_KEY_ID=
TRIAL_R2_SECRET_ACCESS_KEY=
TRIAL_R2_BUCKET=

# Domain suppliers. New registrations route to approved providers: Openprovider (international),
# Register.co.ke (.ke) and registry.co.tz (.tz); the latter two stay disabled until their reseller APIs are documented.
DOMAIN_GENERAL_REGISTRAR=openprovider
DOMAIN_COUNTRY_REGISTRARS={".ke":"register_ke",".tz":"registry_tz"}
OPENPROVIDER_ENABLED=false
OPENPROVIDER_TRANSACTIONS_ENABLED=false
OPENPROVIDER_API_URL=https://api.sandbox.openprovider.nl/v1beta
OPENPROVIDER_USERNAME=
OPENPROVIDER_PASSWORD=
OPENPROVIDER_CLIENT_IP=
OPENPROVIDER_DEFAULT_NAMESERVERS=
OPENPROVIDER_SUPPORTED_EXTENSIONS=.com,.net,.org
OPENPROVIDER_MAX_PRICE_INCREASE_PERCENT=0
