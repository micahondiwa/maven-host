# Production environment for the cPanel Node.js app.
# Copy to ~/<application root>/.env on the server (chmod 600). Never commit real values.
# Lines marked REQUIRED must be set before the first deployment.

# --- Core (REQUIRED) -------------------------------------------------------------------------------------------
APP_ENV=production
# PostgreSQL 10+ database created for this app (a new, separate database; not the live v1 database).
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@localhost:5432/DB_NAME
DB_POOL_MAX=4
# 50+ random characters. If this app will later take over v1's data, use v1's SECRET_KEY so existing sessions,
# reset links and encrypted gateway credentials stay valid.
SECRET_KEY=
# Only if v1 set FIELD_ENCRYPTION_KEY (it encrypts payment-gateway and provider credentials); otherwise leave unset.
FIELD_ENCRYPTION_KEY=
# Public address of this app, without a trailing slash (used in emails, OAuth and payment callbacks).
FRONTEND_URL=https://next.maven-host.com
# Proxies in front of Node.js that append X-Forwarded-For: 1 for Apache/Passenger, 2 if Cloudflare proxies the site.
TRUSTED_PROXY_HOPS=1

# --- Email (REQUIRED: production refuses to send without SMTP) ------------------------------------------------
EMAIL_HOST=host46.registrar-servers.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# Optional overrides (defaults shown).
# NOTIFICATIONS_FROM_EMAIL=MavenHost <notifications@maven-host.com>
# NOREPLY_FROM_EMAIL=MavenHost <noreply@maven-host.com>
# SUPPORT_FROM_EMAIL=MavenHost Support <support@maven-host.com>
# BILLING_FROM_EMAIL=MavenHost Billing <billing@maven-host.com>
# GENERAL_INQUIRY_EMAIL=info@maven-host.com
# SUPPORT_INQUIRY_EMAIL=support@maven-host.com
# DEVELOPER_INQUIRY_EMAIL=developers@maven-host.com

# --- Sign-in with Google / GitHub (optional; each needs all three; redirect URIs use FRONTEND_URL) -------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://next.maven-host.com/oauth/google/callback/
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://next.maven-host.com/oauth/github/callback/

# --- AI builder and assistant (OpenAI first, Anthropic fallback) ---------------------------------------------
AI_PROVIDER_ORDER=openai,anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# --- Seven-day website trials ---------------------------------------------------------------------------------
# `fake` keeps trial deployments in memory (nothing is published). Use cloudflare_r2 with the trial worker for real trials.
TRIAL_DEPLOYMENT_PROVIDER=fake
TRIAL_BASE_DOMAIN=
TRIAL_PUBLIC_SCHEME=https
TRIAL_R2_ENDPOINT=
TRIAL_R2_ACCESS_KEY_ID=
TRIAL_R2_SECRET_ACCESS_KEY=
TRIAL_R2_BUCKET=

# --- Domains: Openprovider (keep disabled until credentials are verified; transactions need explicit approval) --
DOMAIN_GENERAL_REGISTRAR=openprovider
DOMAIN_COUNTRY_REGISTRARS=
OPENPROVIDER_ENABLED=false
OPENPROVIDER_TRANSACTIONS_ENABLED=false
# Production API: https://api.openprovider.eu/v1 (v1beta is switched off on 2027-06-30; legacy sandbox: https://api.sandbox.openprovider.nl/v1beta)
OPENPROVIDER_API_URL=https://api.sandbox.openprovider.nl/v1beta
OPENPROVIDER_USERNAME=
OPENPROVIDER_PASSWORD=
# The server's outbound IPv4 address (whitelisted in Openprovider).
OPENPROVIDER_CLIENT_IP=
OPENPROVIDER_SUPPORTED_EXTENSIONS=.com,.net,.org

# --- Hosting: 20i (no sandbox: every call is live; keep transactions off until approved) ---------------------
TWENTYI_ENABLED=false
TWENTYI_TRANSACTIONS_ENABLED=false
TWENTYI_API_URL=https://api.20i.com
TWENTYI_GENERAL_API_KEY=

# --- Exchange rates for display currencies ---------------------------------------------------------------------
EXCHANGE_RATE_SOURCE=exchangerate-api

# --- First administrator (used once by: tools/manage.mjs createsuperuser --email you@example.com) ------------
DJANGO_SUPERUSER_PASSWORD=
