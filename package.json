{
  "name": "maven-host",
  "version": "2.0.0-migration.0",
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint src server scripts tests",
    "test": "vitest run",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:seed": "npm run manage -- sync_permissions",
    "manage": "node --conditions=react-server --import tsx --env-file=.env.local server/commands/manage.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "lucide-react": "0.468.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "4.3.0",
    "tsx": "^4.23.15",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
